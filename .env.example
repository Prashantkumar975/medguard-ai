# Copy to .env and replace every placeholder with a private value.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
SECRET_KEY=replace-with-at-least-32-random-bytes
SEED_ADMIN_EMAIL=admin@medguard.local
SEED_ADMIN_PASSWORD=replace-with-a-unique-strong-password
